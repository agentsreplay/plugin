{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/ensure-daemon\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/nc -U -w1 \"$HOME/Library/Application Support/AgentReplay/hook.sock\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/nc -U -w1 \"$HOME/Library/Application Support/AgentReplay/hook.sock\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/nc -U -w1 \"$HOME/Library/Application Support/AgentReplay/hook.sock\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/nc -U -w1 \"$HOME/Library/Application Support/AgentReplay/hook.sock\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/nc -U -w1 \"$HOME/Library/Application Support/AgentReplay/hook.sock\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/nc -U -w1 \"$HOME/Library/Application Support/AgentReplay/hook.sock\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/nc -U -w1 \"$HOME/Library/Application Support/AgentReplay/hook.sock\" >/dev/null 2>&1 || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}